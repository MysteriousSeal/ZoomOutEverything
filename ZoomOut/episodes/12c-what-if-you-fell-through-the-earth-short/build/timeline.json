  {
   "text": "Jump into a hole through the Earth, and you'd reach the other side in 42 minutes.",
   "start": 0.35,
   "end": 5.018,
   "phrases": [
    {
     "text": "Jump into a hole through the Earth,",
     "start": 0.35,
     "end": 2.085
    },
    {
     "text": "and you'd reach the other side in 42 minutes.",
     "start": 2.435,
     "end": 5.018
    }
   ]
  },
  {
   "text": "What if you jumped into a hole straight through the Earth?",
   "start": 5.638,
   "end": 8.08,
   "phrases": [

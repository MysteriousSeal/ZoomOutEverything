  },
  {
   "text": "Why does a week have 7 days?",
   "start": 4.924,
   "end": 6.66,
   "phrases": [
    {
     "text": "Why does a week have 7 days?",
     "start": 4.924,
     "end": 6.66
    }
   ]
  },
  {
   "text": "Almost everything on your calendar comes from the sky. Except the week.",
   "start": 6.92,
   "end": 11.055,
   "phrases": [
    {
     "text": "Almost everything on your calendar comes from the sky.",
     "start": 6.92,
     "end": 9.786
    },
    {
     "text": "Except the week.",
     "start": 10.046,
     "end": 11.055
    }
   ]
  },
  {
   "text": "A day, one spin/ of the Earth.",
   "start": 11.315,
   "end": 12.938,
   "phrases": [
    {
     "text": "A day, one spin/ of the Earth.",
     "start": 11.315,
     "end": 12.938
    }
   ]
  },
  {
   "text": "A month about/ one lunar cycle.",
